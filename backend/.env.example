# Database
DATABASE_URL=postgresql+psycopg://boq_user:boq_password@localhost:5432/boq_db
POSTGRES_USER=boq_user
POSTGRES_PASSWORD=boq_password
POSTGRES_DB=boq_db

# JWT
JWT_SECRET_KEY=change-me-to-a-random-64-char-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# OTP
OTP_EXPIRY_MINUTES=10
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5

# SMTP (fill in with real values yourself — never share these in chat)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@boqtool.local

# Social sign-in (Google, GitHub)
#
# Leave OAUTH_MOCK_MODE=true (or a provider's id/secret blank) to keep using the
# built-in mock sign-in — the buttons work end to end locally with no developer
# app. Mock sign-in is refused when ENV=production.
#
# To switch a provider on for real:
#   Google — console.cloud.google.com > APIs & Services > Credentials >
#            Create OAuth client ID > Web application. Add this exact
#            Authorised redirect URI:
#              http://127.0.0.1:8000/auth/oauth/google/callback
#   GitHub — github.com/settings/developers > New OAuth App. Set the
#            Authorization callback URL to:
#              http://127.0.0.1:8000/auth/oauth/github/callback
# Then paste the client id/secret below and set OAUTH_MOCK_MODE=false.
OAUTH_MOCK_MODE=true
OAUTH_REDIRECT_BASE=http://127.0.0.1:8000
OAUTH_SUCCESS_REDIRECT=http://localhost:5173/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Gemini Vision (Shamil's prompt-editing point is app/services/gemini_vision.py)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_MOCK_MODE=true

# App
ENV=development
UPLOAD_DIR=./uploads
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
